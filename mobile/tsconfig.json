{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
    },
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "react-native-css-env.d.ts",
    "nativewind-env.d.ts",
  ],
  "exclude": ["node_modules", ".expo", "android", "ios"],
}
