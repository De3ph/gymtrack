# GymTrack Backend Configuration
# Copy this file to .env and fill in the values.

# JWT secret for signing access and refresh tokens.
# MUST be at least 32 characters long. Required.
JWT_SECRET=

# PostgreSQL connection string. Required.
POSTGRES_DSN=postgres://postgres:password@localhost:5432/gymtrack?sslmode=disable

# Enable in-memory caching (set to "false" to disable).
CACHE_ENABLED=true

# Resend API key for sending password reset emails.
# Leave empty to disable password reset emails (server will still boot).
RESEND_API_KEY=

# Sender address for outbound emails.
# Format: "GymTrack <noreply@yourdomain.com>"
EMAIL_FROM=

# Frontend URL used to build password reset links.
FRONTEND_URL=http://localhost:3000
