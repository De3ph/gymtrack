# --- Required ---
# JWT secret (>= 32 chars). Generate: openssl rand -base64 32
JWT_SECRET=

# PostgreSQL connection string
POSTGRES_DSN=postgres://postgres:password@localhost:5432/gymtrack?sslmode=disable

# --- Optional (enable features) ---
# Resend API key for password reset emails (get from resend.com)
RESEND_API_KEY=

# Sender address for emails, e.g. "GymTrack <noreply@gymtrack.app>"
EMAIL_FROM=

# Frontend URL (used in password reset links)
FRONTEND_URL=http://localhost:3000

# --- Development defaults (override in production) ---
# App environment: development | staging | production
APP_ENV=development

# Gin mode: debug | release | test (defaults to release in production)
# GIN_MODE=

# Server port
PORT=8080

# CORS allowed origins (comma-separated). Empty in production = same-origin only.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Trusted proxy IPs/CIDRs for X-Forwarded-For (comma-separated)
# TRUSTED_PROXIES=

# Swagger server URL for OpenAPI spec (e.g. https://api.example.com/api)
# SWAGGER_SERVER_URL=

# Audit log retention days (0 to disable)
AUDIT_LOG_RETENTION_DAYS=365

# --- Observability (optional) ---
# OpenTelemetry OTLP endpoint (e.g. http://localhost:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Trace sampling ratio 0..1 (default 0.1)
# OTEL_TRACES_SAMPLER_ARG=0.1

# Enable pprof endpoints at /debug/pprof
# PPROF_ENABLED=true

# Enable in-memory caching (default true)
# CACHE_ENABLED=true

# --- Test database (for integration tests) ---
# POSTGRES_TEST_DSN=postgres://postgres:password@localhost:5432/gymtrack_test?sslmode=disable

# --- Admin DSN for db-roles command (superuser) ---
# POSTGRES_ADMIN_DSN=postgres://postgres:password@localhost:5432/postgres?sslmode=disable