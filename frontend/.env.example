# GymTrack frontend — environment contract
#
# Copy to `.env.local` for development. Every variable documented here is
# validated in src/lib/env.ts (or fails fast in src/lib/session.ts); the app
# throws at startup/build time rather than silently falling back to a local
# default in production.

# --- Required in every environment -----------------------------------------

# Base URL of the Go backend REST API, including the `/api` suffix.
# Production: required — a missing/invalid value throws instead of falling
# back to http://localhost:8080/api.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# HMAC key (HS256) used to sign/encrypt the `session` and `refresh_token`
# cookies. Required in ALL environments (no dev fallback). Use >= 32 random
# bytes; rotating it invalidates all active sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Sentry (required in production) ---------------------------------------

# DSN used by the client, server and edge SDKs. Without it the app still runs
# but error monitoring is disabled and a console error is logged at startup.
NEXT_PUBLIC_SENTRY_DSN=

# --- Sentry source-map upload (CI only) -------------------------------------
#
# `widenClientFileUpload: true` in next.config.ts uploads client source maps
# during `next build`, which requires an auth token plus the target org/project.
# Without these, production stack traces stay minified. next.config.ts warns
# when CI is detected and SENTRY_AUTH_TOKEN is absent.
#
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Local-only --------------------------------------------------------------

# Set to `true` to produce a bundle-analyzer report (`pnpm analyze`).
# ANALYZE=false