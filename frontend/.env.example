# Session encryption secret (required for HttpOnly session cookie)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- Sentry (Error & Performance Monitoring) ---

# Public DSN for the client SDK (safe to expose)
NEXT_PUBLIC_SENTRY_DSN=

# DSN for server and edge runtime SDK (falls back to NEXT_PUBLIC_SENTRY_DSN if omitted)
SENTRY_DSN=

# Sentry org/project slugs and auth token (required for source map uploads in CI)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Base URL of the Go backend API (includes /api suffix).
# REQUIRED in production — the build fails fast if unset (src/lib/env.ts).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Public origin of this web app (no trailing slash).
# REQUIRED in production — metadataBase, canonical URLs, sitemap.xml and
# robots.txt are derived from it (src/lib/env.ts, src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public origin of this web app (no trailing slash).
# REQUIRED in production — metadataBase, canonical URLs, sitemap.xml and
# robots.txt are derived from it (src/lib/env.ts, src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
