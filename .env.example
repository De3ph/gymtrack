# GymTrack production environment
# Copy to .env and replace all placeholder values before deploying.

# --- Database ---
POSTGRES_DB=gymtrack
# Superuser used ONLY by the one-shot db-roles/migrate bootstrap.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password

# Least-privilege roles provisioned by `cmd/db-roles` before migrations run.
# The API connects as APP_DB_USER (DML only); migrations run as MIGRATE_DB_USER
# (owns the schema objects). Use long random values.
APP_DB_USER=gymtrack_app
APP_DB_PASSWORD=change-me-app-role-password
MIGRATE_DB_USER=gymtrack_migrate
MIGRATE_DB_PASSWORD=change-me-migrate-role-password

# --- Backend secrets ---
JWT_SECRET=change-me-at-least-32-characters-long-secret
SESSION_SECRET=change-me-at-least-32-characters-long-secret

# --- App URLs ---
# Public URL of the frontend (used for password reset links).
FRONTEND_URL=https://your-domain.com
# API base path exposed to the browser (relative when behind reverse proxy).
NEXT_PUBLIC_API_URL=/api

# --- Email (Resend) - optional, leave empty to disable password reset emails ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Networking ---
# APP_ENV=production makes the backend run gin in release mode; PORT is where
# the API listens inside its container.
APP_ENV=production
PORT=8080
# CORS (comma-separated origins, e.g. https://app.example.com). Leave empty when
# the frontend and API share an origin through the reverse proxy.
CORS_ALLOWED_ORIGINS=
# Fixed subnet for the compose `gymtrack` network, and the only proxies allowed
# to set X-Forwarded-For. Change both together if the subnet collides with
# something on your host. Never widen this to a /8 or /12: every container on
# those ranges could then spoof client IPs and bypass the rate limiter.
GYMTRACK_SUBNET=172.31.0.0/24
TRUSTED_PROXIES=172.31.0.0/24

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
# Public base URL Grafana is served from (behind the reverse proxy, use https).
GRAFANA_ROOT_URL=http://localhost:3001
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=change-me-pgadmin-password

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
PPROF_ENABLED=false

# --- Misc ---
CACHE_ENABLED=true