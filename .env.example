# GymTrack LOCAL TEST environment (docker compose)
# Copy to .env:  cp .env.example .env   (compose reads .env, not this file)
# Then:          docker compose up -d --build
#
# All values below are throwaway test credentials for local docker compose ONLY.
# NEVER use this file (or these values) in production — regenerate every secret
# before deploying.

# --- Database ---
POSTGRES_DB=gymtrack
# Superuser used ONLY by the one-shot db-roles/migrate bootstrap.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test-db-password-123
# Host-side port for the db container (127.0.0.1 only). Change it when a native
# PostgreSQL already listens on 5432; containers always use db:5432 internally.
POSTGRES_HOST_PORT=5433

# Least-privilege roles provisioned by `cmd/db-roles` before migrations run.
# The API connects as APP_DB_USER (DML only); migrations run as MIGRATE_DB_USER
# (owns the schema objects).
APP_DB_USER=gymtrack_app
APP_DB_PASSWORD=test-app-role-password-123
MIGRATE_DB_USER=gymtrack_migrate
MIGRATE_DB_PASSWORD=test-migrate-role-password-123

# --- Backend secrets --- (test values, >= 32 chars as required)
JWT_SECRET=test-jwt-secret-0123456789-0123456789-abc
SESSION_SECRET=test-session-secret-0123456789-0123456789-xyz

# --- App URLs ---
# Behind the compose reverse-proxy (nginx on :80) the frontend and API share an
# origin, so the browser calls the API at the same host under /api.
FRONTEND_URL=http://localhost
# Public origin of the frontend, no trailing slash. REQUIRED by the production
# frontend build — inlined at build time; metadataBase, canonical URLs,
# sitemap.xml and robots.txt derive from it (frontend/src/lib/env.ts).
# The compose reverse proxy serves the app at http://localhost (port 80).
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_API_URL=/api
# Server-only absolute backend URL for Node-side fetch inside the frontend
# container (src/lib/dal.ts, /api/auth/session route handler) — Node fetch
# rejects the relative "/api". Defaults to the compose-internal DNS name.
INTERNAL_API_URL=http://backend:8080/api

# --- Email (Resend) - empty to disable password reset emails in testing ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Networking ---
# development makes gin log verbosely (debug mode) — handy when testing.
# Set to production to mirror deployed behaviour.
APP_ENV=development
PORT=8080
# Empty: same-origin through the reverse proxy, no CORS needed for local tests.
# In production an empty value falls back to the FRONTEND_URL origin, so a
# cross-origin deploy still passes preflights (/clients/*, /workout-plans/*).
# Set explicitly only when the API must allow several origins.
CORS_ALLOWED_ORIGINS=
# Leave empty to keep the OpenAPI spec host-relative (served from the origin
# the swagger UI is opened on, i.e. http://localhost/api).
SWAGGER_SERVER_URL=
# Fixed subnet for the compose `gymtrack` network, and the only proxies allowed
# to set X-Forwarded-For. Change both together if the subnet collides with
# something on your host. Never widen this to a /8 or /12: every container on
# those ranges could then spoof client IPs and bypass the rate limiter.
GYMTRACK_SUBNET=172.31.0.0/24
TRUSTED_PROXIES=172.31.0.0/24

# --- Monitoring ---
# Public client DSN (inlined into the browser bundle at frontend build time).
NEXT_PUBLIC_SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=test-grafana-password-123
# Grafana is published on 127.0.0.1:3001 by compose.
GRAFANA_ROOT_URL=http://localhost:3001
PGADMIN_EMAIL=admin@admin.com
# Only needed for the pgadmin tools profile (`--profile tools`). Compose parses
# without it; pgadmin exits at first init if it is left empty.
PGADMIN_PASSWORD=test-pgadmin-password-123

# --- Admin bootstrap (cmd/create-admin) ---
# Idempotent: creates or promotes the admin account on every deploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=test-admin-password-123
ADMIN_USERNAME=admin


# --- Data retention ---
# Short window for testing; 0 disables pruning entirely.
AUDIT_LOG_RETENTION_DAYS=7

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
PPROF_ENABLED=false

# --- Misc ---
# In-process cache for reference data (users, exercises, equipment, muscle
# groups, relationships, trainer profiles). It is per-instance, NOT shared:
# with multiple replicas a write on one instance does not invalidate another
# instance's cached copy, so a stale value can be served for up to the TTL.
# Set to false (every read goes to PostgreSQL) before scaling horizontally, or
# move the cache to a shared store such as Redis.
CACHE_ENABLED=true
